APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sentence generation. Without a key the add screen hides the generate box and
# sentences are typed by hand. Free tier: 1,500 requests a day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Audio for the sentence and the target word, on the same key as the sentences
# above: no Cloud project and no card, which is why it is Gemini and not Google
# Cloud Text-to-Speech.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Pictures, tried in this order. Openverse needs no key, so cards still get
# pictures with neither of the other two configured.
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Local disk in development. On Render set MEDIA_DISK=s3 and point the AWS_*
# values at Supabase Storage:
#   AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   AWS_USE_PATH_STYLE_ENDPOINT=true
# Uploading and serving use different URLs there, and Storage::url() cannot
# know that — without AWS_URL the files upload fine and then 404 in the
# browser. The bucket must also be marked public for that path to resolve.
MEDIA_DISK=public

# Gemini answers in WAV, roughly ten times the size of MP3, and the Supabase
# free bucket is 1 GB. Needs ffmpeg on the host; without it the WAV is stored
# as it is and nothing breaks.
FLASHAI_COMPRESS_AUDIO=true
